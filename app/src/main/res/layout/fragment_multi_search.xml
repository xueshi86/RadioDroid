<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 展开筛选条件按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExpandFilters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_sm"
        android:text="@string/multi_search_expand_filters"
        android:textAllCaps="false"
        app:cornerRadius="@dimen/radius_sm" />

    <!-- 筛选条件区域 -->
    <ScrollView
        android:id="@+id/scrollViewFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_sm">

            <!-- 国家筛选 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/multi_search_country"
                    android:textAppearance="@style/TextAppearance.RadioDroid.Caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/spinnerCountry"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center_vertical|start"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="@dimen/space_md"
                    android:paddingEnd="@dimen/space_sm"
                    android:text="@string/multi_search_all"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="@dimen/text_body"
                    app:cornerRadius="@dimen/radius_sm" />
            </LinearLayout>

            <!-- 语言筛选 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/multi_search_language"
                    android:textAppearance="@style/TextAppearance.RadioDroid.Caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center_vertical|start"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="@dimen/space_md"
                    android:paddingEnd="@dimen/space_sm"
                    android:text="@string/multi_search_all"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="@dimen/text_body"
                    app:cornerRadius="@dimen/radius_sm" />
            </LinearLayout>

            <!-- 标签筛选 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/multi_search_tag"
                    android:textAppearance="@style/TextAppearance.RadioDroid.Caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/spinnerTag"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center_vertical|start"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="@dimen/space_md"
                    android:paddingEnd="@dimen/space_sm"
                    android:text="@string/multi_search_all"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="@dimen/text_body"
                    app:cornerRadius="@dimen/radius_sm" />
            </LinearLayout>

            <!-- 关键词搜索 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/multi_search_keyword"
                    android:textAppearance="@style/TextAppearance.RadioDroid.Caption" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/etSearchQueryLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                    app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                    app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                    app:boxCornerRadiusTopStart="@dimen/radius_sm"
                    android:hint="@string/multi_search_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearchQuery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="@dimen/text_body_small" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 按钮区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <!-- 收起筛选条件按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleFilters"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:text="@string/multi_search_expand_filters"
                    android:textAllCaps="false"
                    app:cornerRadius="@dimen/radius_sm" />
                <!-- 重置筛选按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetFilters"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_xs"
                    android:text="@string/multi_search_reset"
                    android:textAllCaps="false"
                    app:cornerRadius="@dimen/radius_sm" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 电台列表 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:id="@+id/swiperefresh"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewStations"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical" />

            <LinearLayout
                android:id="@+id/layoutError"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_xl"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/stateIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_rd_state_empty"
                    app:tint="?attr/colorTextTertiary" />

                <TextView
                    android:id="@+id/textErrorMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center"
                    android:text="@string/multi_search_no_results"
                    android:textAppearance="@style/TextAppearance.RadioDroid.Title"
                    android:textColor="?attr/colorTextSecondary" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutLoading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/state_loading"
                    android:textAppearance="@style/TextAppearance.RadioDroid.BodySmall"
                    android:textColor="?attr/colorTextSecondary" />

            </LinearLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabScrollToTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="40dp"
                android:layout_marginBottom="@dimen/space_lg"
                app:srcCompat="@drawable/ic_arrow_upward_24dp"
                android:visibility="gone"
                app:fabSize="mini"
                app:backgroundTint="?attr/colorPrimary"
                app:tint="@android:color/white" />

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>