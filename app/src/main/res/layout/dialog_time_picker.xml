<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="@dimen/space_xl"
    android:paddingEnd="@dimen/space_xl"
    android:paddingTop="@dimen/space_lg"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alarm_set_time"
        android:textAppearance="@style/TextAppearance.RadioDroid.Title"
        android:layout_marginBottom="@dimen/space_lg"
        android:importantForAccessibility="no" />

    <!-- 滚轮卡片：统一圆角 + 内嵌底色，选中项高、未选中项矮的滚动逻辑在 CompactNumberPicker 内保持不变 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/timePickerCardBackground"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm">

            <net.programmierecke.radiodroid2.alarm.CompactNumberPicker
                android:id="@+id/npHour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="@dimen/text_display"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:textColor="?attr/timePickerValueColor"
                android:importantForAccessibility="no" />

            <net.programmierecke.radiodroid2.alarm.CompactNumberPicker
                android:id="@+id/npMinute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:layout_marginTop="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelTime"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alarm_cancel"
            android:textColor="?attr/presetAccentColor"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmTime"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:text="@string/alarm_save"
            android:textColor="?attr/presetAccentColor"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false" />

    </LinearLayout>
</LinearLayout>