<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
    <!--android:visibility="gone">-->

    <net.programmierecke.radiodroid2.views.TagsView
            android:id="@+id/viewTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1"
            android:textSize="@dimen/text_title"
            app:cornerRadius="8dp"
            app:tagBackgroundColor="?attr/tagBackgroundColor"
            app:tagHeight="25sp"
            app:textHorizontalPadding="8dp"
            app:textVerticalMargin="4dp" />

    <!-- 电台备注行 + 编辑入口（Issue #54）：点击整行弹出备注编辑对话框 -->
    <LinearLayout
            android:id="@+id/layoutNoteRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

        <TextView
                android:id="@+id/textNoteDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="4sp"
                android:ellipsize="end"
                android:lines="1"
                android:textAppearance="@style/TextAppearance.RadioDroid.Note" />

        <com.mikepenz.iconics.view.IconicsImageButton
                android:id="@+id/buttonEditNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/touch_target_min"
                android:minHeight="@dimen/touch_target_min"
                android:padding="4dp"
                android:contentDescription="@string/note_edit_title"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/iconsInItemBackgroundColor"
                app:iiv_icon="gmd-pencil"
                app:iiv_padding="2dp"
                app:iiv_size="20dp"/>
    </LinearLayout>


    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <com.mikepenz.iconics.view.IconicsImageButton
                android:id="@+id/buttonVisitWebsite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="@dimen/touch_target_min"
                android:minHeight="@dimen/touch_target_min"
                android:padding="4dp"
                android:contentDescription="@string/detail_visit_website"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/iconsInItemBackgroundColor"
                app:iiv_icon="gmd-home"
                app:iiv_padding="2dp"
                app:iiv_size="24dp"/>

        <ImageButton
            android:id="@+id/buttonShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_share"
            app:srcCompat="@drawable/ic_share_24dp"
            app:tint="?attr/iconsInItemBackgroundColor" />

        <ImageButton
                android:id="@+id/buttonBookmark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="@dimen/touch_target_min"
                android:minHeight="@dimen/touch_target_min"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/detail_star"
                app:tint="?attr/iconsInItemBackgroundColor"
                app:srcCompat="@drawable/ic_star_border_black_24dp" />

        <ImageButton
                android:id="@+id/buttonAddAlarm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="@dimen/touch_target_min"
                android:minHeight="@dimen/touch_target_min"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/description_btn_setup_alarm"
                app:tint="?attr/iconsInItemBackgroundColor"
                app:srcCompat="@drawable/ic_add_alarm_black_24dp" />

        <ImageButton
                android:id="@+id/buttonBufferSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="@dimen/touch_target_min"
                android:minHeight="@dimen/touch_target_min"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/detail_buffer_settings"
                app:tint="?attr/iconsInItemBackgroundColor"
                app:srcCompat="@drawable/ic_buffer_settings_24dp" />

        <ImageButton
                android:id="@+id/buttonEqualizerSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="@dimen/touch_target_min"
                android:minHeight="@dimen/touch_target_min"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/detail_equalizer_settings"
                app:tint="?attr/iconsInItemBackgroundColor"
                app:srcCompat="@drawable/ic_equalizer_24dp" />

        <ImageButton
            android:id="@+id/buttonPlayInRadioDroid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="@dimen/touch_target_min"
            android:minHeight="@dimen/touch_target_min"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_play_in_radiodroid"
            app:tint="?attr/iconsInItemBackgroundColor"
            app:srcCompat="@drawable/ic_play_in_radiodroid" />

        <ImageButton
                android:id="@+id/buttonRefreshIcon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="@dimen/touch_target_min"
                android:minHeight="@dimen/touch_target_min"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/context_menu_refresh_icon"
                app:tint="?attr/iconsInItemBackgroundColor"
                app:srcCompat="@drawable/ic_refresh_black_24dp" />
    </LinearLayout>

</LinearLayout>
