<?xml version="1.0" encoding="utf-8"?>
<!-- 「电台信息」页 v4.2（整页 Hero + 方形图标）：
     分段条之下 → 控制条之上整页为沉浸式 Hero 模糊背景（imageViewArt 位图放大模糊镜像，
     无 logo 电台用主题色渐变兜底，见 FragmentPlayerFull），上叠上下压暗 scrim。
     前景自上而下：
     ① 方形电台图标卡（92dp 白底圆角卡，代码动态定位：图标中心对齐 Hero 高度的
        0.382 黄金分割点，见 FragmentPlayerFull 布局回调）；
     ② 中段弹性居中（两枚 weight=1 Space）：电台名（≤3 行自适应字号居中优雅展现）→
        正在播放行（强调色呼吸点 + 曲目）→ 码率/编码/地区/语言元数据胶囊 →
        缓冲+流量状态胶囊（两枚挨在一起整组居中，未播放时只显示标签名）；
     ③ 备注行贴底：轻量居中文字行，空态「添加备注」提示，点击整行弹出编辑对话框。
     固定布局无需滚动；风格标签与「本次/累计收听」已移除。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Hero 背景：logo 放大模糊位图（60% 不透明度由代码设置）或主题色渐变兜底 -->
    <ImageView
        android:id="@+id/heroBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <!-- 上下压暗 scrim：保证顶部唱片区与底部备注行的白字在任意背景上可读 -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/player_hero_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ① 电台图标展示卡（v3.1.1 方形样式）：92dp 白底圆角卡 + 白描边 + 投影，
             顶边距 60dp 仅为初值，实际由代码按 Hero 高度黄金分割 0.382 动态定位
             （图标中心对齐分割点，见 FragmentPlayerFull）；
             图标不论原图多大一律 fitCenter 缩放进卡内（适配大小不一/无图标电台） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/heroLogoCard"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="60dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="@android:color/white"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/imageViewArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/tab_player_station_info"
                android:padding="12dp"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 中段弹性空隙：信息组在图标与备注行之间垂直居中；marginTop 补偿底部
             备注行占位（约 40dp），使信息组几何中心对齐「图标底 ↔ 控制条顶」的
             中点（不补偿会整体偏下备注行高的一半） -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="40dp"
            android:layout_weight="1" />

        <!-- ② 电台名：≤3 行自适应字号（20→28sp）+ 平衡折行，长名不再拥挤 -->
        <TextView
            android:id="@+id/heroStationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="28sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="balanced"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="3"
            android:paddingStart="22dp"
            android:paddingLeft="22dp"
            android:paddingEnd="22dp"
            android:paddingRight="22dp"
            android:shadowColor="@color/player_hero_text_shadow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Whisperings: Solo Piano Radio" />

        <!-- ③ 正在播放行：行首强调色呼吸点（代码注入）+ 曲目信息；
             wrap_content 让呼吸点与居中文字一起整体居中（match_parent 会把
             compound drawable 甩到屏幕左缘与文字分离） -->
        <TextView
            android:id="@+id/heroNowPlaying"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="@dimen/space_lg"
            android:paddingLeft="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingRight="@dimen/space_lg"
            android:shadowColor="@color/player_hero_text_shadow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@color/player_hero_text_soft"
            android:textSize="@dimen/text_body_small"
            tools:text="正在播放：John Boswell - From This Day" />

        <!-- ④ 元数据胶囊行：比特率 · 编码 · 地区 · 语言（半透明白底胶囊，流式居中换行） -->
        <net.programmierecke.radiodroid2.views.TagsView
            android:id="@+id/heroMetaChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="1"
            android:paddingStart="@dimen/space_lg"
            android:paddingLeft="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingRight="@dimen/space_lg"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_label"
            app:cornerRadius="99dp"
            app:tagBackgroundColor="@color/player_hero_chip_bg"
            app:tagHeight="20sp"
            app:textHorizontalPadding="@dimen/space_sm"
            app:textVerticalMargin="2dp"
            tools:text="48 kbps  AAC+  美国 · 俄勒冈  english" />

        <!-- ⑤ 缓冲 + 流量状态胶囊：两枚挨在一起整组居中（底色/描边由代码按配色方案注入） -->
        <LinearLayout
            android:id="@+id/statRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statBufferChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="5dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingLeft="12dp"
                android:paddingTop="4dp"
                android:paddingRight="12dp"
                android:paddingBottom="4dp"
                android:shadowColor="@color/player_hero_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="@string/player_stat_buffer"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_label"
                tools:text="缓冲时长" />

            <TextView
                android:id="@+id/statTrafficChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:drawablePadding="5dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingLeft="12dp"
                android:paddingTop="4dp"
                android:paddingRight="12dp"
                android:paddingBottom="4dp"
                android:shadowColor="@color/player_hero_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="@string/player_stat_data"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_label"
                tools:text="流量" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ⑥ 备注行（贴底）：轻量居中文字行，空态「添加备注」提示，点击整行编辑 -->
        <LinearLayout
            android:id="@+id/layoutStationNoteRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_xs">

            <TextView
                android:id="@+id/textViewStationNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4sp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxWidth="320dp"
                android:maxLines="1"
                android:shadowColor="@color/player_hero_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textAppearance="@style/TextAppearance.RadioDroid.Note" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
