<?xml version="1.0" encoding="utf-8"?>
<!-- 「电台信息」页 v4.2（整页 Hero + 方形图标）：
     分段条之下 → 控制条之上整页为沉浸式 Hero 模糊背景（imageViewArt 位图放大模糊镜像，
     无 logo 电台用主题色渐变兜底，见 FragmentPlayerFull），上叠上下压暗 scrim。
     前景自上而下：
     ① 方形电台图标卡（92dp 白底圆角卡，代码动态定位：图标中心对齐 Hero 高度的
        25% 处，见 FragmentPlayerFull 布局回调）；
     ② 中段信息组（顶部 Space 高度由代码计算，组中心对齐 Hero 高度 55%）：
        电台名（≤3 行自适应字号居中优雅展现）→
        码率/编码/地区/语言元数据胶囊 →
        缓冲+流量状态胶囊（两枚挨在一起整组居中，未播放时只显示标签名）→
        正在播放行（强调色呼吸点 + 曲目，位于组末尾，未播放时隐藏只影响自身）；
     ③ 备注行贴底：轻量居中文字行，空态「添加备注」提示，点击整行弹出编辑对话框。
     固定布局无需滚动；风格标签与「本次/累计收听」已移除。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Hero 背景：logo 放大模糊位图（60% 不透明度由代码设置）或主题色渐变兜底 -->
    <ImageView
        android:id="@+id/heroBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <!-- 色斑涌动层（播放时屏保级动画）：从电台图标提取的 4~5 个主色各生成一枚
         大型径向渐变色斑（中心实色→边缘透明，天然柔和无需 blur），播放时各斑独立
         大幅游走 + 呼吸胀缩 + 明暗呼吸，叠加形成「色块涌动」；未播放时整层透明，
         背景静止显示底层的模糊电台图标 -->
    <FrameLayout
        android:id="@+id/heroBgBlobs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">

        <!-- 基底：取色占比最大的主色铺满（代码注入 60~75% 透明度），色斑叠于其上 -->
        <View
            android:id="@+id/heroBlobBase"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/heroBlob1"
            android:layout_width="560dp"
            android:layout_height="560dp"
            android:layout_gravity="center"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/heroBlob2"
            android:layout_width="500dp"
            android:layout_height="500dp"
            android:layout_gravity="center"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/heroBlob3"
            android:layout_width="600dp"
            android:layout_height="600dp"
            android:layout_gravity="center"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/heroBlob4"
            android:layout_width="530dp"
            android:layout_height="530dp"
            android:layout_gravity="center"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/heroBlob5"
            android:layout_width="470dp"
            android:layout_height="470dp"
            android:layout_gravity="center"
            tools:ignore="ContentDescription" />

        <!-- 文字护盾层：中央椭圆软渐变（信息组 55% 高度处最暗、向外羽化透明），
             无论色斑如何涌动，中段信息组区域的背景亮度恒定，白字始终可读 -->
        <ImageView
            android:id="@+id/heroBlobShield"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <!-- 上下压暗 scrim：保证顶部唱片区与底部备注行的白字在任意背景上可读 -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/player_hero_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ① 电台图标展示卡（v3.1.1 方形样式）：92dp 白底圆角卡 + 白描边 + 投影，
             顶边距 60dp 仅为初值，实际由代码按 Hero 高度 25% 动态定位（图标中心
             对齐该点，见 FragmentPlayerFull）；
             图标不论原图多大一律 fitCenter 缩放进卡内（适配大小不一/无图标电台） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/heroLogoCard"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="60dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="@android:color/white"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/imageViewArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/tab_player_station_info"
                android:padding="12dp"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 中段弹性空隙（顶部）：高度由代码精确计算，使信息组中心对齐 Hero 高度
             的 55%（用户指定）；剩余空间由底部 weight=1 Space 吸收，备注行贴底 -->
        <Space
            android:id="@+id/heroTopSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <!-- ② 电台名：≤3 行自适应字号（20→28sp）+ 平衡折行，长名不再拥挤 -->
        <TextView
            android:id="@+id/heroStationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="28sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="balanced"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="3"
            android:paddingStart="22dp"
            android:paddingLeft="22dp"
            android:paddingEnd="22dp"
            android:paddingRight="22dp"
            android:shadowColor="@color/player_hero_text_shadow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Whisperings: Solo Piano Radio" />

        <!-- ③ 元数据胶囊行：比特率 · 编码 · 地区 · 语言（半透明白底胶囊，流式居中换行） -->
        <net.programmierecke.radiodroid2.views.TagsView
            android:id="@+id/heroMetaChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="1"
            android:paddingStart="@dimen/space_lg"
            android:paddingLeft="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingRight="@dimen/space_lg"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_label"
            app:cornerRadius="99dp"
            app:tagBackgroundColor="@color/player_hero_chip_bg"
            app:tagHeight="20sp"
            app:textHorizontalPadding="@dimen/space_sm"
            app:textVerticalMargin="2dp"
            tools:text="48 kbps  AAC+  美国 · 俄勒冈  english" />

        <!-- ⑤ 缓冲 + 流量状态胶囊：两枚挨在一起整组居中（底色/描边由代码按配色方案注入）；
             信息组各行间距统一 space_md（原 space_sm 加大 50%） -->
        <LinearLayout
            android:id="@+id/statRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <!-- 状态胶囊高度固定 20sp（与元数据胶囊 TagsView 的 tagHeight 精确一致，
                 此前 minHeight 24dp 导致视觉偏大）；前导图标由代码注入（时钟/流量，
                 与胶囊文字同调白色） -->
            <TextView
                android:id="@+id/statBufferChip"
                android:layout_width="wrap_content"
                android:layout_height="20sp"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingLeft="8dp"
                android:paddingTop="0dp"
                android:paddingRight="8dp"
                android:paddingBottom="0dp"
                android:shadowColor="@color/player_hero_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="@string/player_stat_buffer"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_label"
                tools:text="缓冲时长" />

            <TextView
                android:id="@+id/statTrafficChip"
                android:layout_width="wrap_content"
                android:layout_height="20sp"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingLeft="8dp"
                android:paddingTop="0dp"
                android:paddingRight="8dp"
                android:paddingBottom="0dp"
                android:shadowColor="@color/player_hero_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="@string/player_stat_data"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_label"
                tools:text="流量" />
        </LinearLayout>

        <!-- ⑤ 正在播放行（置于状态胶囊下一行，隐藏时只影响自身不挤动上方内容）：
             行首强调色呼吸点（代码注入）+ 曲目信息；wrap_content 让呼吸点与
             居中文字一起整体居中（match_parent 会把 compound drawable 甩到
             屏幕左缘与文字分离） -->
        <TextView
            android:id="@+id/heroNowPlaying"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="@dimen/space_lg"
            android:paddingLeft="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingRight="@dimen/space_lg"
            android:shadowColor="@color/player_hero_text_shadow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@color/player_hero_text_soft"
            android:textSize="@dimen/text_body_small"
            tools:text="正在播放：John Boswell - From This Day" />

        <!-- 「正在录音」行（信息组末行）：录音中显示（行首红色圆点 + 文件名），
             与录音列表页的录音块互斥呈现，停止录音即消失 -->
        <TextView
            android:id="@+id/heroNowRecording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="@dimen/space_lg"
            android:paddingLeft="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingRight="@dimen/space_lg"
            android:shadowColor="@color/player_hero_text_shadow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@color/player_hero_text_soft"
            android:textSize="@dimen/text_body_small"
            android:visibility="gone"
            tools:text="正在录音：AsiaFM-20260101_120000.mp3" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ⑥ 备注行（贴底）：轻量居中文字行，空态「添加备注」提示，点击整行编辑 -->
        <LinearLayout
            android:id="@+id/layoutStationNoteRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_xs">

            <TextView
                android:id="@+id/textViewStationNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4sp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxWidth="320dp"
                android:maxLines="1"
                android:shadowColor="@color/player_hero_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textAppearance="@style/TextAppearance.RadioDroid.Note" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
