<?xml version="1.0" encoding="utf-8"?>
<!-- 电台列表项：根节点为卡片（id 保持 station_foreground，供拖拽/滑动复用），
     卡片之间用留白分隔，不再依赖 DividerItemDecoration。 -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/station_foreground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_sm"
    android:layout_marginLeft="@dimen/space_sm"
    android:layout_marginEnd="@dimen/space_sm"
    android:layout_marginRight="@dimen/space_sm"
    android:layout_marginTop="@dimen/space_xxs"
    android:layout_marginBottom="@dimen/space_xxs"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/item_press_anim"
    app:cardBackgroundColor="?attr/colorSurfaceCard"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:rippleColor="?attr/colorRipple"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
                android:id="@+id/layoutMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/item_height_standard"
                android:paddingStart="@dimen/space_xs"
                android:paddingLeft="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:paddingRight="@dimen/space_xs">

            <FrameLayout
                    android:id="@+id/frameLayout"
                    android:layout_width="@dimen/icon_station_list"
                    android:layout_height="@dimen/icon_station_list"
                    android:layout_gravity="center_vertical"
                    android:measureAllChildren="true">

                <ImageView
                        android:id="@+id/imageViewIcon"
                        android:layout_width="@dimen/icon_station_list"
                        android:layout_height="@dimen/icon_station_list"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/transparentCircle"
                    android:layout_width="@dimen/icon_station_list"
                    android:layout_height="@dimen/icon_station_list"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_transparent_circle"
                    app:tint="?android:attr/windowBackground" />

                <ImageView
                    android:id="@+id/trendStatusIcon"
                    android:layout_width="@dimen/icon_action"
                    android:layout_height="@dimen/icon_action"
                    android:layout_gravity="top|start"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_trending_flat_black_24dp" />

                <ImageView
                        android:id="@+id/starredStatusIcon"
                        android:layout_width="@dimen/icon_action"
                        android:layout_height="@dimen/icon_action"
                        android:layout_gravity="top|end"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_star_transparent_with_border_24dp" />

                <ImageView
                    android:id="@+id/playingOverlay"
                    android:layout_width="@dimen/icon_station_list"
                    android:layout_height="@dimen/icon_station_list"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    android:scaleType="fitCenter" />

            </FrameLayout>

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_xs"
                    android:paddingLeft="@dimen/space_sm"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingTop="@dimen/space_xs">

                <TextView
                        android:id="@+id/textViewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:lines="1"
                        android:scrollbars="none"
                        android:textAppearance="@style/TextAppearance.RadioDroid.Title" />

                <TextView
                        android:id="@+id/textViewShortDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4sp"
                        android:ellipsize="end"
                        android:lines="1"
                        android:scrollbars="none"
                        android:textAppearance="@style/TextAppearance.RadioDroid.BodySmall" />

                <TextView
                        android:id="@+id/textViewTags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:lines="1"
                        android:scrollbars="none"
                        android:textAppearance="@style/TextAppearance.RadioDroid.Caption" />

            </LinearLayout>

            <ImageButton
                    android:id="@+id/buttonMore"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/image_button_more"
                    android:minWidth="@dimen/touch_target_min"
                    android:padding="@dimen/space_sm"
                    app:tint="?attr/iconsInItemBackgroundColor"
                    app:srcCompat="@drawable/ic_expand_more_white_24dp" />
        </LinearLayout>

        <ViewStub
                android:id="@+id/stubDetails"
                android:inflatedId="@+id/layoutDetails"
                android:layout="@layout/stub_list_item_station_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_lg"
                android:layout_marginLeft="@dimen/space_lg"
                android:layout_marginRight="@dimen/space_lg"
                android:layout_marginStart="@dimen/space_lg"
                android:clickable="true"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>