<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <!-- Drag handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bottom_sheet_drag_handle" />

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_buffer_settings_24dp"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/bufferDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/buffer_strategy_title"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle2"
            android:textColor="?attr/colorOnSurface" />

    </LinearLayout>

    <!-- Strategy options using RadioGroup -->
    <RadioGroup
        android:id="@+id/strategyRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <!-- LIGHT strategy -->
        <RadioButton
            android:id="@+id/radioLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:paddingBottom="0dp"
            android:text="@string/buffer_strategy_light"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="2dp"
            android:text="@string/buffer_strategy_light_desc"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- ENHANCED strategy -->
        <RadioButton
            android:id="@+id/radioEnhanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:paddingBottom="0dp"
            android:text="@string/buffer_strategy_enhanced"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="2dp"
            android:text="@string/buffer_strategy_enhanced_desc"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- EXTREME strategy -->
        <RadioButton
            android:id="@+id/radioExtreme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:paddingBottom="0dp"
            android:text="@string/buffer_strategy_extreme"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="2dp"
            android:text="@string/buffer_strategy_extreme_desc"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

    </RadioGroup>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/bufferBtnCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:textColor="?attr/colorPrimary"
            android:text="@android:string/cancel" />

        <Button
            android:id="@+id/bufferBtnApply"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:textColor="?attr/colorPrimary"
            android:text="@string/buffer_settings_apply" />

    </LinearLayout>

</LinearLayout>
