<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_xs"
    android:paddingBottom="@dimen/space_sm">

    <!-- Drag handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_sm"
        android:background="@drawable/bottom_sheet_drag_handle" />

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_md">

        <ImageView
            android:layout_width="@dimen/icon_action_small"
            android:layout_height="@dimen/icon_action_small"
            app:srcCompat="@drawable/ic_buffer_settings_24dp"
            app:tint="?attr/presetAccentColor"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/bufferDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/buffer_strategy_title"
            android:textAppearance="@style/TextAppearance.RadioDroid.Title" />

    </LinearLayout>

    <!-- Strategy options using RadioGroup -->
    <RadioGroup
        android:id="@+id/strategyRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_lg">

        <!-- LIGHT strategy -->
        <RadioButton
            android:id="@+id/radioLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/buffer_strategy_light"
            android:textStyle="bold"
            android:textSize="@dimen/text_body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/buffer_strategy_light_desc"
            android:textAppearance="@style/TextAppearance.RadioDroid.Caption" />

        <!-- ENHANCED strategy -->
        <RadioButton
            android:id="@+id/radioEnhanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/buffer_strategy_enhanced"
            android:textStyle="bold"
            android:textSize="@dimen/text_body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/buffer_strategy_enhanced_desc"
            android:textAppearance="@style/TextAppearance.RadioDroid.Caption" />

        <!-- EXTREME strategy -->
        <RadioButton
            android:id="@+id/radioExtreme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/buffer_strategy_extreme"
            android:textStyle="bold"
            android:textSize="@dimen/text_body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/buffer_strategy_extreme_desc"
            android:textAppearance="@style/TextAppearance.RadioDroid.Caption" />

    </RadioGroup>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm"
        android:paddingTop="@dimen/space_xs">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bufferBtnCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/presetAccentColor"
            android:textAllCaps="false"
            android:text="@android:string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bufferBtnApply"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/presetAccentColor"
            android:textAllCaps="false"
            android:text="@string/buffer_settings_apply" />

    </LinearLayout>

</LinearLayout>