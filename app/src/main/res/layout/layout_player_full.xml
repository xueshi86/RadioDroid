<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPlayerBackground"
    android:orientation="vertical">

    <View
        android:id="@+id/dividerTop"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_thickness"
        android:background="?attr/colorPlayerShadow" />

    <net.programmierecke.radiodroid2.views.RecyclerAwareNestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 通用标题行（正在播放曲目 / 电台名 + 连接类型图标）：
                 「电台信息」段由页内 Hero 沉浸区承担电台名与正在播放，本行隐藏
                 （分段条上移）；切到其余三段时恢复显示，充当列表上下文。
                 显隐由 FragmentPlayerFull 按当前分段控制 -->
            <LinearLayout
                android:id="@+id/rowNowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textViewGeneralInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_marginLeft="@dimen/space_sm"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_marginRight="@dimen/space_xs"
                    android:gravity="center_horizontal"
                    android:maxHeight="72sp"
                    android:minHeight="36sp"
                    android:textAlignment="center"
                    android:textColor="?attr/colorTextPrimary"
                    android:autoSizeMaxTextSize="@dimen/text_headline"
                    android:autoSizeMinTextSize="@dimen/text_body"
                    android:autoSizeTextType="uniform"
                    tools:text="Info" />

                <ImageView
                    android:id="@+id/imageViewConnectionTypeFull"
                    android:layout_width="@dimen/icon_action_small"
                    android:layout_height="@dimen/icon_action_small"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_marginRight="@dimen/space_sm"
                    android:contentDescription="@string/content_desc_connection_type"
                    android:visibility="gone"
                    tools:src="@drawable/ic_network_wifi" />
            </LinearLayout>

            <!-- 单行四段分段控件（UI 审查 P1-2 及后续调整）：合并原先两行 PagerTabStrip，
                 「电台信息 | 本台曲目 | 曲目历史 | 录音」四页全部保留（「电台信息」段驱动
                 信息 pane、后三段驱动历史 pager）；选中胶囊背景由代码按当前主题强调色绘制，
                 胶囊文字按 WCAG 亮度自动取黑/白，因此此处不写死任何颜色 -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/segmentTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginLeft="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginRight="12dp"
                android:background="@android:color/transparent"
                app:tabBackground="@android:color/transparent"
                app:tabGravity="fill"
                app:tabIndicatorHeight="0dp"
                app:tabMode="fixed"
                app:tabPaddingBottom="3dp"
                app:tabPaddingEnd="2dp"
                app:tabPaddingStart="2dp"
                app:tabPaddingTop="3dp"
                app:tabRippleColor="@android:color/transparent" />

            <!-- 内容 pager（电台信息 / 本台曲目 / 曲目历史 / 录音列表四页，支持横滑翻页）：
                 高度由代码按剩余可视空间计算 -->
            <androidx.viewpager.widget.ViewPager
                android:id="@+id/pagerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 录音状态块（v4.1 浮层样式）：「录音状态栏只在电台信息和录音界面显示」——
                 圆角半透明深底卡片浮于页底（背景/描边由代码按配色方案注入，见
                 applyInfoPageThemeStyles），结构对齐录音列表条目（上下 padding +
                 Title 文件名 + Caption 大小，文字改白色系适配深底），堆叠在内容 pager
                 下方，显隐由代码按当前段与录音状态控制 -->
            <LinearLayout
                android:id="@+id/blockRecording"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_md"
                    android:paddingBottom="@dimen/space_md">

                    <ImageView
                        android:id="@+id/imgRecordingIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_marginLeft="@dimen/space_lg"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_marginRight="@dimen/space_sm"
                        app:srcCompat="@drawable/ic_start_recording"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_lg"
                        android:layout_marginRight="@dimen/space_lg"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewRecordingName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.RadioDroid.Title"
                            android:textColor="@color/player_hero_text_soft"
                            android:textStyle="bold"
                            tools:text="recording name.mp3" />

                        <TextView
                            android:id="@+id/textViewRecordingSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.RadioDroid.Caption"
                            android:textColor="@color/player_hero_text_dim"
                            tools:text="2.5 mb" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </net.programmierecke.radiodroid2.views.RecyclerAwareNestedScrollView>

    <View
        android:id="@+id/dividerBottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_thickness"
        android:background="?attr/colorPlayerShadow" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPlaybackControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs">

        <!-- v3.1 控制条（直播形态，v2 已确立）：仅 录音 · 播放 · 收藏 三键，
             移除上一曲 / 下一曲。按键尺寸沿用现版本（用户确认：设计稿按键过小，
             以现状为准）——播放 72dp、录音/收藏 48dp，图标满幅显示 -->

        <ImageButton
            android:id="@+id/buttonRecord"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/image_button_record"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/buttonPlay"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_start_recording" />

        <ImageButton
            android:id="@+id/buttonPlay"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_play"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_play_circle" />

        <ImageButton
            android:id="@+id/buttonFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_favorite"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/buttonPlay"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_star_24dp" />


    </androidx.constraintlayout.widget.ConstraintLayout>


</LinearLayout>
