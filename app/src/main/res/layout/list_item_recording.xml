<?xml version="1.0" encoding="utf-8"?>
<!-- 录音列表项：补上点击涟漪反馈，间距与文字色统一走设计令牌。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_sm"
    android:focusable="true">

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:textAppearance="@style/TextAppearance.RadioDroid.Title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.RadioDroid.Caption" />

    <!-- 行间分割线（UI 美化）：浅色主题下录音条目不再粘连 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_thickness"
        android:layout_marginTop="@dimen/space_sm"
        android:background="?attr/colorSeparator" />

</LinearLayout>