<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_md"
        android:text="@string/sleep_timer_set_title"
        android:textAppearance="@style/TextAppearance.RadioDroid.Title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <EditText
            android:id="@+id/timerInputEditText"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="2"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.RadioDroid.Headline"
            android:hint="1-99"
            android:background="@android:drawable/edit_text"
            android:padding="@dimen/space_md" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:text="@string/sleep_timer_minutes_label"
            android:textAppearance="@style/TextAppearance.RadioDroid.Title" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/sleep_timer_hint"
        android:textAppearance="@style/TextAppearance.RadioDroid.BodySmall" />

</LinearLayout>