<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mini_player_height"
    android:background="?attr/colorPlayerBackground"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/playerTopSeparator"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_thickness"
        android:background="?attr/colorPlayerShadow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/playerBottomSeparator"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_thickness"
        android:background="?attr/colorPlayerShadow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/playerRadioImage"
        android:layout_width="@dimen/mini_player_cover"
        android:layout_height="@dimen/mini_player_cover"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginLeft="@dimen/space_sm"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/flag_nl" />

    <ImageView
        android:id="@+id/transparentCircle"
        android:layout_width="@dimen/mini_player_cover"
        android:layout_height="@dimen/mini_player_cover"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginLeft="@dimen/space_sm"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_transparent_circle"
        app:tint="?attr/colorPlayerBackground" />

    <TextView
        android:id="@+id/textViewStationName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginLeft="@dimen/space_sm"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/colorAccent"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/textViewLiveInfo"
        app:layout_constraintEnd_toStartOf="@id/barrierEndButtons"
        app:layout_constraintStart_toEndOf="@id/playerRadioImage"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Station name (Long long long long long long long long long long long long long text)" />

    <TextView
        android:id="@+id/textViewLiveInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginLeft="@dimen/space_sm"
        android:ellipsize="end"
        android:gravity="top"
        android:singleLine="true"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="@dimen/text_caption"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/barrierEndButtons"
        app:layout_constraintStart_toEndOf="@id/playerRadioImage"
        app:layout_constraintTop_toBottomOf="@id/textViewStationName"
        tools:text="Song (Long long long long long long long long long long long long long text)" />

    <TextView
        android:id="@+id/textViewLiveInfoBig"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginLeft="@dimen/space_sm"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:maxLines="1"
        android:textColor="?attr/colorAccent"
        android:textSize="@dimen/text_body"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/barrierEndButtons"
        app:layout_constraintStart_toEndOf="@id/playerRadioImage"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Song (Long long long long long long long long long long long long long text)" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierEndButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="start"
        app:constraint_referenced_ids="buttonPlay,buttonMore,imageViewConnectionType" />

    <!-- 连接状态图标（WiFi/流量）：PLAYER 态在播放键左侧；HEADER 态播放键 GONE，
         塌缩锚点落到右缘，用 goneMargin 让图标右缘对齐 ⋮ 的 start（48dp 按钮 + 12dp
         边距），确保展开态顶栏图标显示在 ⋮ 收纳按钮之前（左侧） -->
    <ImageView
        android:id="@+id/imageViewConnectionType"
        android:layout_width="@dimen/icon_action_small"
        android:layout_height="@dimen/icon_action_small"
        android:layout_marginEnd="@dimen/space_xs"
        android:layout_marginRight="@dimen/space_xs"
        android:contentDescription="@string/content_desc_connection_type"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonPlay"
        app:layout_goneMarginEnd="60dp"
        app:layout_goneMarginRight="60dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_network_wifi" />

    <!-- 播放/暂停按钮：与迷你播放器行高同高的正方形（0dp + 1:1 比例 + 上下约束到 parent），
         与改版前一致；图标固有尺寸 48dp，靠 fitCenter 随按钮一起放大到行高 -->
    <ImageButton
        android:id="@+id/buttonPlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/space_sm"
        android:layout_marginRight="@dimen/space_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/detail_play"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_play_circle" />

    <ImageButton
        android:id="@+id/buttonMore"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/space_sm"
        android:layout_marginRight="@dimen/space_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/image_button_more"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_more" />

</androidx.constraintlayout.widget.ConstraintLayout>