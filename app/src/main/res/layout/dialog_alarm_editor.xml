<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?android:attr/colorBackground"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:contentPadding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_edit_title"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/textViewEditorStation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditorTime"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="32sp"
                android:textColor="?attr/alarmTimeButtonColor"
                android:backgroundTint="@android:color/transparent"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerHorizontal"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_fade_in"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/textViewStartVolumeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody2"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderStartVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1"
                android:valueTo="100"
                android:stepSize="1"
                app:thumbColor="?attr/sliderThumbColor"
                app:haloColor="?attr/sliderHaloColor"
                app:trackColorActive="?attr/sliderTrackActiveColor"
                app:trackColorInactive="?attr/sliderTrackInactiveColor"
                app:tickColorActive="?attr/sliderTickColor"
                app:tickColorInactive="?attr/sliderTickInactiveColor"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textViewTargetVolumeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody2"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderTargetVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1"
                android:valueTo="100"
                android:stepSize="1"
                app:thumbColor="?attr/sliderThumbColor"
                app:haloColor="?attr/sliderHaloColor"
                app:trackColorActive="?attr/sliderTrackActiveColor"
                app:trackColorInactive="?attr/sliderTrackInactiveColor"
                app:tickColorActive="?attr/sliderTickColor"
                app:tickColorInactive="?attr/sliderTickInactiveColor"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textViewFadeDurationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBody2"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderFadeDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="120"
                android:stepSize="5"
                app:thumbColor="?attr/sliderThumbColor"
                app:haloColor="?attr/sliderHaloColor"
                app:trackColorActive="?attr/sliderTrackActiveColor"
                app:trackColorInactive="?attr/sliderTrackInactiveColor"
                app:tickColorActive="?attr/sliderTickColor"
                app:tickColorInactive="?attr/sliderTickInactiveColor"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textViewFadeWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAlignment="center"
                android:text="@string/alarm_fade_invalid_range"
                android:textColor="?attr/colorError"
                android:textAppearance="?attr/textAppearanceBody2"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
