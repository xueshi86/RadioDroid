<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/space_lg">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceElevated"
        app:cardCornerRadius="@dimen/radius_dialog"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:contentPadding="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_edit_title"
                android:textAppearance="@style/TextAppearance.RadioDroid.TitleLarge"
                android:layout_marginBottom="@dimen/space_lg" />

            <TextView
                android:id="@+id/textViewEditorStation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RadioDroid.Title"
                android:layout_marginBottom="@dimen/space_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditorTime"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_display"
                android:textColor="?attr/alarmTimeButtonColor"
                android:backgroundTint="@android:color/transparent"
                android:paddingTop="@dimen/space_md"
                android:paddingBottom="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_lg" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_thickness"
                android:background="?attr/colorSeparator"
                android:layout_marginBottom="@dimen/space_lg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alarm_fade_in"
                android:textAppearance="@style/TextAppearance.RadioDroid.Title"
                android:layout_marginBottom="@dimen/space_md" />

            <TextView
                android:id="@+id/textViewStartVolumeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RadioDroid.BodySmall"
                android:layout_marginBottom="@dimen/space_xs" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderStartVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1"
                android:valueTo="100"
                android:stepSize="1"
                app:thumbColor="?attr/sliderThumbColor"
                app:haloColor="?attr/sliderHaloColor"
                app:trackColorActive="?attr/sliderTrackActiveColor"
                app:trackColorInactive="?attr/sliderTrackInactiveColor"
                app:tickColorActive="?attr/sliderTickColor"
                app:tickColorInactive="?attr/sliderTickInactiveColor"
                android:layout_marginBottom="@dimen/space_sm" />

            <TextView
                android:id="@+id/textViewTargetVolumeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RadioDroid.BodySmall"
                android:layout_marginBottom="@dimen/space_xs" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderTargetVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1"
                android:valueTo="100"
                android:stepSize="1"
                app:thumbColor="?attr/sliderThumbColor"
                app:haloColor="?attr/sliderHaloColor"
                app:trackColorActive="?attr/sliderTrackActiveColor"
                app:trackColorInactive="?attr/sliderTrackInactiveColor"
                app:tickColorActive="?attr/sliderTickColor"
                app:tickColorInactive="?attr/sliderTickInactiveColor"
                android:layout_marginBottom="@dimen/space_sm" />

            <TextView
                android:id="@+id/textViewFadeDurationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RadioDroid.BodySmall"
                android:layout_marginBottom="@dimen/space_xs" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderFadeDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="120"
                android:stepSize="5"
                app:thumbColor="?attr/sliderThumbColor"
                app:haloColor="?attr/sliderHaloColor"
                app:trackColorActive="?attr/sliderTrackActiveColor"
                app:trackColorInactive="?attr/sliderTrackInactiveColor"
                app:tickColorActive="?attr/sliderTickColor"
                app:tickColorInactive="?attr/sliderTickInactiveColor"
                android:layout_marginBottom="@dimen/space_sm" />

            <TextView
                android:id="@+id/textViewFadeWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAlignment="center"
                android:text="@string/alarm_fade_invalid_range"
                android:textColor="?attr/colorError"
                android:textAppearance="@style/TextAppearance.RadioDroid.BodySmall"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/space_sm" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
