<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ListView
        android:id="@+id/listViewAlarms"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 闹钟空态（UI 美化）：列表为空时显示，与列表同层覆盖，不改变既有列表逻辑 -->
    <LinearLayout
        android:id="@+id/emptyAlarms"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_rd_state_empty"
            app:tint="?attr/colorTextTertiary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center"
            android:text="@string/empty_alarms"
            android:textAppearance="@style/TextAppearance.RadioDroid.Title"
            android:textColor="?attr/colorTextSecondary" />

    </LinearLayout>

</FrameLayout>