        android:fillColor="?attr/presetAccentColor"
        android:pathData="M4.5,5H5.4V19H4.5Z" />
    <!-- 外框：右边 x 18.6-19.5 / y 5-19 -->
    <path
        android:fillColor="?attr/presetAccentColor"
        android:pathData="M18.6,5H19.5V19H18.6Z" />

    <!-- 内容行 1：x 7.9-16.1 / y 9.15-10.05 -->
    <path
        android:fillColor="?attr/presetAccentColor"
        android:pathData="M7.9,9.15H16.1V10.05H7.9Z" />
