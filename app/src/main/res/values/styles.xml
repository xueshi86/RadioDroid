<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material themes -->
    <style name="MyMaterialTheme" parent="MyMaterialTheme.Base" />
    <style name="MyMaterialTheme.Dark" parent="MyMaterialTheme.Base.Dark" />
    
    <style name="MyMaterialTheme.Base" parent="Theme.MaterialComponents.Light">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <!-- 预设配色（Issue #50）：基础主题只声明 4 个预设属性，其余颜色全部由它们派生；
             更换预设时只需用 ThemePreset.xxx 覆盖这 4 个属性即可整体换色 -->
        <item name="presetPrimaryColor">@color/preset_classic_blue_primary</item>
        <item name="presetAccentColor">@color/preset_classic_blue_accent</item>
        <item name="presetAccentBrightColor">@color/preset_classic_blue_accent_dark</item>
        <item name="presetWindowBackground">@color/windowBackground</item>
        <item name="presetSurfaceBackground">@color/colorSurfaceElevated</item>
        <item name="colorSeparator">@color/colorSeparator</item>
        <item name="colorStationUnavailable">@color/colorStationUnavailable</item>
        <item name="colorStationDeleted">@color/colorStationDeleted</item>
        <!-- 颜色角色（UI 美化）：布局与样式只引用这些角色，不再写死色值 -->
        <item name="colorSurfaceCard">@color/colorSurfaceCard</item>
        <item name="colorSurfaceElevated">@color/colorSurfaceElevated</item>
        <item name="colorTextPrimary">@color/colorTextPrimaryLight</item>
        <item name="colorTextSecondary">@color/colorTextSecondaryLight</item>
        <item name="colorTextTertiary">@color/colorTextTertiaryLight</item>
        <item name="colorRipple">@color/colorRippleLight</item>
        <item name="android:windowBackground">?attr/presetWindowBackground</item>
        <item name="colorPrimary">?attr/presetPrimaryColor</item>
        <item name="colorPrimaryDark">?attr/presetPrimaryColor</item>
        <item name="colorAccent">?attr/presetAccentColor</item>
        <item name="colorTabUnderline">?attr/presetAccentBrightColor</item>
        <!-- 抽屉与底栏文字/底色（API16-20 同样赋值，避免引用落空）：
             选中态走预设强调色，未选中态走文字角色，底栏底色用卡片面 -->
        <item name="menuTextColorSelected">?attr/presetAccentColor</item>
        <item name="menuTextColorDefault">?attr/colorTextPrimary</item>
        <item name="menuBottomTextColorSelected">?attr/presetAccentColor</item>
        <item name="menuBottomTextColorDefault">?attr/colorTextSecondary</item>
        <item name="menuBottomBackgroundColor">?attr/colorSurfaceCard</item>
        <item name="actionButtonStyle">@style/ToolbarActionButton</item>
        <!-- 设置页偏好样式（UI 美化）：分组标题走 Label 字阶 + 强调色 -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.RadioDroid</item>
    </style>
    
    <style name="MyMaterialTheme.Base.Dark" parent="Theme.MaterialComponents">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="presetPrimaryColor">@color/preset_classic_blue_primary_dark</item>
        <item name="presetAccentColor">@color/preset_classic_blue_accent_dark</item>
        <item name="presetAccentBrightColor">@color/preset_classic_blue_accent_dark</item>
        <item name="presetWindowBackground">@color/windowBackgroundDark</item>
        <item name="presetSurfaceBackground">@color/colorSurfaceElevatedDark</item>
        <item name="colorSeparator">@color/colorSeparatorDark</item>
        <item name="colorStationUnavailable">@color/colorStationUnavailableDark</item>
        <item name="colorStationDeleted">@color/colorStationDeletedDark</item>
        <!-- 颜色角色（UI 美化）：布局与样式只引用这些角色，不再写死色值 -->
        <item name="colorSurfaceCard">@color/colorSurfaceCardDark</item>
        <item name="colorSurfaceElevated">@color/colorSurfaceElevatedDark</item>
        <item name="colorTextPrimary">@color/colorTextPrimaryDark</item>
        <item name="colorTextSecondary">@color/colorTextSecondaryDark</item>
        <item name="colorTextTertiary">@color/colorTextTertiaryDark</item>
        <item name="colorRipple">@color/colorRippleDark</item>
        <item name="android:windowBackground">?attr/presetWindowBackground</item>
        <item name="colorPrimary">?attr/presetPrimaryColor</item>
        <item name="colorPrimaryDark">?attr/presetPrimaryColor</item>
        <item name="colorAccent">?attr/presetAccentColor</item>
        <item name="colorTabUnderline">?attr/presetAccentBrightColor</item>
        <!-- 抽屉与底栏文字/底色 -->
        <item name="menuTextColorSelected">?attr/presetAccentColor</item>
        <item name="menuTextColorDefault">?attr/colorTextPrimary</item>
        <item name="menuBottomTextColorSelected">?attr/presetAccentColor</item>
        <item name="menuBottomTextColorDefault">?attr/colorTextSecondary</item>
        <item name="menuBottomBackgroundColor">?attr/colorSurfaceCard</item>
        <item name="actionButtonStyle">@style/ToolbarActionButton</item>
        <!-- 设置页偏好样式（UI 美化）：分组标题走 Label 字阶 + 强调色 -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.RadioDroid</item>
    </style>
    
    <!-- Dialog themes -->
    <style name="DialogTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">?attr/presetAccentColor</item>
        <item name="colorPrimaryDark">?attr/presetPrimaryColor</item>
        <item name="colorAccent">?attr/presetAccentColor</item>
        <!-- 时间选择器滚轮文字/分割线/按钮（浅色主题）：全部走颜色角色或命名色，不再写死色值 -->
        <item name="timePickerValueColor">@color/colorTextPrimaryLight</item>
        <item name="timePickerDividerColor">@color/colorTextSecondaryLight</item>
        <item name="timePickerButtonColor">?attr/presetAccentColor</item>
        <item name="timePickerCardBackground">@color/colorSurfaceInset</item>
        <!-- 闹钟编辑页控件（浅色主题跟随预设强调色） -->
        <item name="alarmTimeButtonColor">?attr/presetAccentColor</item>
        <item name="sliderThumbColor">?attr/presetAccentColor</item>
        <item name="sliderHaloColor">?attr/presetAccentColor</item>
        <item name="sliderTrackActiveColor">?attr/presetAccentColor</item>
        <item name="sliderTrackInactiveColor">@color/colorSliderInactive</item>
        <item name="sliderTickColor">?attr/presetAccentColor</item>
        <item name="sliderTickInactiveColor">@color/colorSliderInactive</item>
    </style>

    
    <style name="DialogTheme.Dark" parent="Theme.MaterialComponents.Dialog">
        <item name="colorPrimary">?attr/presetAccentColor</item>
        <item name="colorPrimaryDark">?attr/presetPrimaryColor</item>
        <item name="colorAccent">?attr/presetAccentColor</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
        <item name="android:windowBackground">?attr/presetSurfaceBackground</item>
        <item name="android:colorBackground">?attr/presetSurfaceBackground</item>
        <item name="android:background">?attr/presetSurfaceBackground</item>
        <!-- 时间选择器滚轮文字/分割线/按钮（暗色主题）：与浅色主题走同一套颜色角色 -->
        <item name="timePickerValueColor">@color/colorTextPrimaryDark</item>
        <item name="timePickerDividerColor">@color/colorTextSecondaryDark</item>
        <item name="timePickerButtonColor">?attr/presetAccentColor</item>
        <item name="timePickerCardBackground">@color/colorSurfaceInsetDark</item>
        <!-- 闹钟编辑页控件（暗色主题跟随预设强调色） -->
        <item name="alarmTimeButtonColor">?attr/presetAccentColor</item>
        <item name="sliderThumbColor">?attr/presetAccentColor</item>
        <item name="sliderHaloColor">@color/colorSliderHaloDark</item>
        <item name="sliderTrackActiveColor">?attr/presetAccentColor</item>
        <item name="sliderTrackInactiveColor">@color/colorSliderInactiveDark</item>
        <item name="sliderTickColor">?attr/presetAccentColor</item>
        <item name="sliderTickInactiveColor">@color/colorSliderInactiveDark</item>
    </style>

    <!-- Alert themes -->
    <style name="AlertTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">?attr/presetAccentColor</item>
        <item name="colorPrimaryDark">?attr/presetPrimaryColor</item>
        <item name="colorAccent">?attr/presetAccentColor</item>
        <!-- 闹钟编辑页控件（浅色主题跟随预设强调色） -->
        <item name="alarmTimeButtonColor">?attr/presetAccentColor</item>
        <item name="sliderThumbColor">?attr/presetAccentColor</item>
        <item name="sliderHaloColor">?attr/presetAccentColor</item>
        <item name="sliderTrackActiveColor">?attr/presetAccentColor</item>
        <item name="sliderTrackInactiveColor">@color/colorSliderInactive</item>
        <item name="sliderTickColor">?attr/presetAccentColor</item>
        <item name="sliderTickInactiveColor">@color/colorSliderInactive</item>
    </style>

    
    <style name="AlertTheme.Dark" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">?attr/presetAccentColor</item>
        <item name="colorPrimaryDark">?attr/presetPrimaryColor</item>
        <item name="colorAccent">?attr/presetAccentColor</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
        <item name="buttonBarButtonStyle">@style/AlertButtonStyle.Dark</item>
        <item name="materialButtonStyle">@style/AlertButtonStyle.Dark</item>
        <item name="android:windowBackground">?attr/presetSurfaceBackground</item>
        <item name="android:colorBackground">?attr/presetSurfaceBackground</item>
        <item name="android:background">?attr/presetSurfaceBackground</item>
        <!-- 闹钟编辑页控件颜色（暗色主题跟随预设强调色） -->
        <item name="alarmTimeButtonColor">?attr/presetAccentColor</item>
        <item name="sliderThumbColor">?attr/presetAccentColor</item>
        <item name="sliderHaloColor">@color/colorSliderHaloDark</item>
        <item name="sliderTrackActiveColor">?attr/presetAccentColor</item>
        <item name="sliderTrackInactiveColor">@color/colorSliderInactiveDark</item>
        <item name="sliderTickColor">?attr/presetAccentColor</item>
        <item name="sliderTickInactiveColor">@color/colorSliderInactiveDark</item>
    </style>

    <!-- ================= 设置页偏好样式（UI 美化） =================
         继承 androidx.preference 的默认覆盖层，只调整一项：
         分组标题改用与其他设置项一致的 Title 字阶（16sp），颜色仍走预设强调色。 -->
    <style name="PreferenceThemeOverlay.RadioDroid" parent="PreferenceThemeOverlay">
        <item name="preferenceCategoryTitleTextAppearance">@style/TextAppearance.RadioDroid.Title</item>
        <item name="preferenceCategoryTitleTextColor">?attr/presetAccentColor</item>
    </style>

    <!-- 覆盖 androidx.preference 的行摘要样式（摘要统一 Caption 字阶） -->
    <style name="PreferenceSummaryTextStyle">
        <item name="android:textAppearance">@style/TextAppearance.RadioDroid.Caption</item>
    </style>

    
    <style name="AlertButtonStyle.Dark" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/text_title</item>
    </style>


    
    <!-- Bottom sheet dialog themes -->
    <style name="BottomSheetDialogTheme" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="colorPrimary">?attr/presetAccentColor</item>
        <item name="colorPrimaryDark">?attr/presetPrimaryColor</item>
        <item name="colorAccent">?attr/presetAccentColor</item>
    </style>
    
    <style name="BottomSheetDialogTheme.Dark" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="colorPrimary">?attr/presetAccentColor</item>
        <item name="colorPrimaryDark">?attr/presetPrimaryColor</item>
        <item name="colorAccent">?attr/presetAccentColor</item>
        <item name="colorOnSurface">@android:color/white</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
    </style>
    
    <!-- Menu text appearance -->
    <style name="MenuTextAppearance" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">@dimen/text_title</item>
    </style>
    
    <style name="MenuTextAppearance.Dark" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- ================= 字阶（UI 美化） =================
         全项目文字统一走这几级，布局里不再散写 textSize；
         颜色一律引用 ?attr/colorText*，随亮/暗主题与预设配色联动。 -->
    <style name="TextAppearance.RadioDroid" parent="TextAppearance.AppCompat" />

    <!-- 大号数字：闹钟时间、时间选择器 -->
    <style name="TextAppearance.RadioDroid.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
    </style>

    <style name="TextAppearance.RadioDroid.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
    </style>

    <style name="TextAppearance.RadioDroid.TitleLarge">
        <item name="android:textSize">@dimen/text_title_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
    </style>

    <style name="TextAppearance.RadioDroid.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
    </style>

    <style name="TextAppearance.RadioDroid.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
    </style>

    <style name="TextAppearance.RadioDroid.BodySmall">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">?attr/colorTextSecondary</item>
    </style>

    <style name="TextAppearance.RadioDroid.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">?attr/colorTextSecondary</item>
    </style>

    <style name="TextAppearance.RadioDroid.Label">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorTextTertiary</item>
    </style>

    <!-- Snackbar button styles -->
    <style name="SnackBarButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/presetAccentColor</item>
    </style>
    
    <style name="SnackBarButtonDark" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/presetAccentColor</item>
    </style>
    
    <!-- Custom spinner dropdown style -->
    <style name="CustomSpinnerDropDown" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:scrollbarSize">16dp</item>
        <item name="android:scrollbarThumbVertical">@drawable/custom_scrollbar</item>
        <item name="android:scrollbarTrackVertical">@android:color/transparent</item>
        <item name="android:scrollbarStyle">outsideOverlay</item>
    </style>
    
    <!-- Custom spinner style -->
    <style name="CustomSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:dropDownListViewStyle">@style/CustomSpinnerDropDown</item>
    </style>
    
    <!-- Progress bar styles -->
    <style name="ProgressBarCircle" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateDrawable">@drawable/progress_circle</item>
    </style>
    
    <!-- Toolbar action button style（触摸目标统一 ≥48dp） -->
    <style name="ToolbarActionButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:paddingLeft">@dimen/space_xs</item>
        <item name="android:paddingRight">@dimen/space_xs</item>
    </style>

    <!-- Icon button style -->
    <style name="IconButton" parent="Widget.AppCompat.Button">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">8dp</item>
    </style>

    <!-- ================= 预设配色覆盖样式（Issue #50） =================
         亮色 / 暗色各一套，只覆盖 4 个预设属性；
         Theme.applyStyle() 应用后，主色、强调色、窗口底色、内容面底色
         以及派生出的全部颜色（顶栏/状态栏/播放条/标签下划线/对话框等）随之整体切换。 -->
    <!-- 空基样式：供 ThemePreset.xxx 作为隐式父样式继承（带点号的样式名要求父样式存在） -->
    <style name="ThemePreset" />
    <style name="ThemePreset.ClassicBlue">
        <item name="presetPrimaryColor">@color/preset_classic_blue_primary</item>
        <item name="presetAccentColor">@color/preset_classic_blue_accent</item>
        <item name="presetAccentBrightColor">@color/preset_classic_blue_accent_dark</item>
    </style>
    <style name="ThemePreset.ClassicBlue.Dark">
        <item name="presetPrimaryColor">@color/preset_classic_blue_primary_dark</item>
        <item name="presetAccentColor">@color/preset_classic_blue_accent_dark</item>
        <item name="presetAccentBrightColor">@color/preset_classic_blue_accent_dark</item>
    </style>

    <style name="ThemePreset.LakeTeal">
        <item name="presetPrimaryColor">@color/preset_lake_teal_primary</item>
        <item name="presetAccentColor">@color/preset_lake_teal_accent</item>
        <item name="presetAccentBrightColor">@color/preset_lake_teal_accent_dark</item>
    </style>
    <style name="ThemePreset.LakeTeal.Dark">
        <item name="presetPrimaryColor">@color/preset_lake_teal_primary_dark</item>
        <item name="presetAccentColor">@color/preset_lake_teal_accent_dark</item>
        <item name="presetAccentBrightColor">@color/preset_lake_teal_accent_dark</item>
    </style>

    <style name="ThemePreset.ForestGreen">
        <item name="presetPrimaryColor">@color/preset_forest_green_primary</item>
        <item name="presetAccentColor">@color/preset_forest_green_accent</item>
        <item name="presetAccentBrightColor">@color/preset_forest_green_accent_dark</item>
    </style>
    <style name="ThemePreset.ForestGreen.Dark">
        <item name="presetPrimaryColor">@color/preset_forest_green_primary_dark</item>
        <item name="presetAccentColor">@color/preset_forest_green_accent_dark</item>
        <item name="presetAccentBrightColor">@color/preset_forest_green_accent_dark</item>
    </style>

    <style name="ThemePreset.Violet">
        <item name="presetPrimaryColor">@color/preset_violet_primary</item>
        <item name="presetAccentColor">@color/preset_violet_accent</item>
        <item name="presetAccentBrightColor">@color/preset_violet_accent_dark</item>
    </style>
    <style name="ThemePreset.Violet.Dark">
        <item name="presetPrimaryColor">@color/preset_violet_primary_dark</item>
        <item name="presetAccentColor">@color/preset_violet_accent_dark</item>
        <item name="presetAccentBrightColor">@color/preset_violet_accent_dark</item>
    </style>

    <style name="ThemePreset.Rose">
        <item name="presetPrimaryColor">@color/preset_rose_primary</item>
        <item name="presetAccentColor">@color/preset_rose_accent</item>
        <item name="presetAccentBrightColor">@color/preset_rose_accent_dark</item>
    </style>
    <style name="ThemePreset.Rose.Dark">
        <item name="presetPrimaryColor">@color/preset_rose_primary_dark</item>
        <item name="presetAccentColor">@color/preset_rose_accent_dark</item>
        <item name="presetAccentBrightColor">@color/preset_rose_accent_dark</item>
    </style>

    <style name="ThemePreset.SunsetOrange">
        <item name="presetPrimaryColor">@color/preset_sunset_orange_primary</item>
        <item name="presetAccentColor">@color/preset_sunset_orange_accent</item>
        <item name="presetAccentBrightColor">@color/preset_sunset_orange_accent_dark</item>
    </style>
    <style name="ThemePreset.SunsetOrange.Dark">
        <item name="presetPrimaryColor">@color/preset_sunset_orange_primary_dark</item>
        <item name="presetAccentColor">@color/preset_sunset_orange_accent_dark</item>
        <item name="presetAccentBrightColor">@color/preset_sunset_orange_accent_dark</item>
    </style>

    <style name="ThemePreset.Graphite">
        <item name="presetPrimaryColor">@color/preset_graphite_primary</item>
        <item name="presetAccentColor">@color/preset_graphite_accent</item>
        <item name="presetAccentBrightColor">@color/preset_graphite_accent_dark</item>
    </style>
    <style name="ThemePreset.Graphite.Dark">
        <item name="presetPrimaryColor">@color/preset_graphite_primary_dark</item>
        <item name="presetAccentColor">@color/preset_graphite_accent_dark</item>
        <item name="presetAccentBrightColor">@color/preset_graphite_accent_dark</item>
    </style>

    <style name="ThemePreset.PureBlack">
        <item name="presetPrimaryColor">@color/preset_pure_black_primary</item>
        <item name="presetAccentColor">@color/preset_pure_black_accent</item>
        <item name="presetAccentBrightColor">@color/preset_pure_black_accent_dark</item>
    </style>
    <style name="ThemePreset.PureBlack.Dark">
        <item name="presetPrimaryColor">@color/preset_pure_black_primary_dark</item>
        <item name="presetAccentColor">@color/preset_pure_black_accent_dark</item>
        <item name="presetAccentBrightColor">@color/preset_pure_black_accent_dark</item>
        <!-- 纯黑预设：窗口与内容面改为纯黑系 -->
        <item name="presetWindowBackground">@color/preset_pure_black_window_dark</item>
        <item name="presetSurfaceBackground">@color/preset_pure_black_surface_dark</item>
        <!-- 表面层次同样压到纯黑系，保持"窗口 → 卡片 → 弹层"三级可辨 -->
        <item name="colorSurfaceCard">@color/preset_pure_black_surface_dark</item>
        <item name="colorSurfaceElevated">@color/preset_pure_black_surface_dark</item>
    </style>
</resources>