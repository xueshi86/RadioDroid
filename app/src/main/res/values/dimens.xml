<?xml version="1.0" encoding="utf-8"?>
<!-- RadioDroid 设计令牌（UI 美化）：
     全项目间距 / 圆角 / 尺寸 / 字号统一从这里取，布局里不再手写 dp、sp。
     间距取自 4dp 基准，字号取自 7 级字阶（外加一个用于大号数字的 display）。 -->
<resources>

    <!-- ================= 间距 ================= -->
    <dimen name="space_xxs">2dp</dimen>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_2xl">32dp</dimen>

    <!-- ================= 圆角 ================= -->
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_card">12dp</dimen>
    <dimen name="radius_dialog">16dp</dimen>
    <dimen name="radius_cover">16dp</dimen>

    <!-- ================= 尺寸 ================= -->
    <dimen name="touch_target_min">48dp</dimen>
    <dimen name="appbar_height">56dp</dimen>
    <!-- 标准行高（大图标模式）：图标 56dp + 三行文字（标题/详情/标签），内容约 63dp。
         仅在原 88dp 基础上略微收紧到 80dp；60dp 是紧凑模式（小图标、不显示详情行）的高度，
         两者需保持明显差异 -->
    <dimen name="item_height_standard">80dp</dimen>
    <dimen name="item_height_compact">72dp</dimen>
    <dimen name="icon_station_list">56dp</dimen>
    <!-- 「正在播放」高亮边框容器：必须大于图标（icon_station_list），
         否则边框会被图标完全盖住而看不见（边框画在容器背景上，位于子视图之下） -->
    <dimen name="icon_station_list_frame">64dp</dimen>
    <dimen name="icon_station_grid">72dp</dimen>
    <!-- 图标模式（网格）「正在播放」高亮边框容器：必须大于图标（icon_station_grid），
         否则描边框画在容器背景上会被图标完全盖住而不可见 -->
    <dimen name="icon_station_grid_frame">80dp</dimen>
    <dimen name="icon_action">24dp</dimen>
    <dimen name="icon_action_small">20dp</dimen>
    <dimen name="mini_player_height">64dp</dimen>
    <dimen name="mini_player_cover">48dp</dimen>
    <dimen name="cover_size_full">240dp</dimen>
    <dimen name="divider_thickness">1dp</dimen>
    <dimen name="divider_inset">16dp</dimen>

    <!-- ================= 字号字阶 ================= -->
    <dimen name="text_display">40sp</dimen>
    <dimen name="text_headline">24sp</dimen>
    <dimen name="text_title_large">20sp</dimen>
    <dimen name="text_title">16sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_body_small">13sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_label">11sp</dimen>

</resources>