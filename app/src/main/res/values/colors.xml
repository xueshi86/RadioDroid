<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ================= 表面层次（UI 美化） =================
         窗口 < 卡片 < 弹层，三层由暗到亮（暗色主题下由深到浅），
         让列表卡片、底栏、对话框从页面底色上"浮"起来。
         纯黑预设在暗色主题下另有一组覆盖值（见 preset_pure_black_*）。 -->
    <color name="windowBackground">#F4F5F7</color>
    <color name="windowBackgroundDark">#121214</color>
    <color name="colorSurfaceCard">#FFFFFF</color>
    <color name="colorSurfaceCardDark">#1E1E20</color>
    <color name="colorSurfaceElevated">#FFFFFF</color>
    <color name="colorSurfaceElevatedDark">#26262A</color>

    <!-- 文字三层 -->
    <color name="colorTextPrimaryLight">#1A1A1A</color>
    <color name="colorTextPrimaryDark">#ECECEC</color>
    <color name="colorTextSecondaryLight">#6B6B6B</color>
    <color name="colorTextSecondaryDark">#A8A8A8</color>
    <color name="colorTextTertiaryLight">#9A9A9A</color>
    <color name="colorTextTertiaryDark">#7C7C7C</color>

    <!-- 点击涟漪 -->
    <color name="colorRippleLight">#14000000</color>
    <color name="colorRippleDark">#1FFFFFFF</color>

    <!-- 对话框内嵌控件（UI 美化）：时间选择器滚轮卡片底色、滑块未激活轨道/刻度与光晕。
         对话框主题只引用这些命名色，样式里不再出现裸十六进制。 -->
    <color name="colorSurfaceInset">#F0F0F0</color>
    <color name="colorSurfaceInsetDark">#3A3A3C</color>
    <color name="colorSliderInactive">#3D808080</color>
    <color name="colorSliderInactiveDark">#66FFFFFF</color>
    <color name="colorSliderHaloDark">#33FFFFFF</color>

    <!-- 状态指示（UI 美化）：连接检测等状态点的「成功」色。
         亮色主题用深绿保证白底可读，暗色主题用亮绿保证深底可读。 -->
    <color name="colorStatusOk">#2E7D32</color>
    <color name="colorStatusOkDark">#81C784</color>

    <!-- 电台可用性状态底色（UI 美化）：替代原先的纯黄 / 纯红硬编码底色。
         亮色主题用浅底 + 深色文字，暗色主题用深底 + 浅色文字，
         避免暗色主题下浅色电台名落在亮黄底上看不清。
         Issue #50 反馈：两种主题下都把"失效 / 已删除"的深浅观感对调——
         亮色主题加深、加饱和（仍配深色文字），暗色主题提亮（仍配浅色文字），
         让标记底色在各自的页面底色上更醒目，同时保持卡片内文字可读。 -->
    <color name="colorStationUnavailable">#FFE09C</color>
    <color name="colorStationUnavailableDark">#54430F</color>
    <color name="colorStationDeleted">#FFD8D8</color>
    <color name="colorStationDeletedDark">#6B3232</color>

    <!-- ================= 旧血统颜色（逐步废弃） =================
         以下色值属于 fork 前的旧配色，不再跟随预设配色。
         页面与样式不应再直接引用它们；仅在尚未改造完成的角落保留，改造完成后删除。 -->
    <color name="colorPrimaryDark">#232325</color>
    <color name="textColorPrimary">#FFFFFF</color>
    <color name="navigationBarColor">#000000</color>
    <!-- 暗色主题对话框主色：比强调色更亮，保证暗色背景上文字/滑块清晰可见 -->
    <color name="colorAlertPrimaryDark">#64B5F6</color>
    <color name="colorStationSwipeBackground">#ff4081</color>

    <color name="colorPlayerBackground">#ffffff</color>
    <color name="colorPlayerBackgroundDark">@color/colorPrimaryDark</color>
    <color name="colorPlayerShadow">#e5e5e5</color>
    <color name="colorPlayerShadowDark">#000000</color>

    <color name="textColorSecondary">#777</color>
    <color name="tagBackgroundColor">#E0E0E0</color>
    <color name="tagBackgroundColorDark">#212121</color>

    <!-- 全屏播放器「电台信息」页 Hero 沉浸区覆盖层：
         压在电台图片 / 主题渐变之上的常量色（白色文字、半透明胶囊、暗化 scrim），
         属于图像覆盖层而非配色方案色板，不随 8 套预设变化 -->
    <color name="player_hero_scrim_end">#6B000000</color>
    <color name="player_hero_chip_bg">#2BFFFFFF</color>
    <color name="player_hero_text_soft">#E6FFFFFF</color>
    <color name="player_hero_text_shadow">#59000000</color>
    <!-- v4.1 整页 Hero 补充覆盖色：空态备注弱化 / 录音块次级文字 / 录音块深底 -->
    <color name="player_hero_text_faint">#9EFFFFFF</color>
    <color name="player_hero_text_dim">#B3FFFFFF</color>
    <color name="player_hero_rec_bg">#B80C1814</color>

    <!-- 列表 / 详情页分隔线（中性色，不随预设变化） -->
    <color name="colorSeparator">#E3E3E5</color>
    <color name="colorSeparatorDark">#2E2E30</color>

    <!-- ================= 预设配色（Issue #50） =================
         每套预设只有「主色 + 强调色」两个槽位，亮色 / 暗色主题各一组色值：
         同一槽位在两种主题下色相保持一致，仅调整明度与饱和度，
         保证亮底与暗底下都清晰、耐看。
         primary    → 顶栏、状态栏（暗色下同时作为播放条底色）
         accent     → 按钮、选中文字、滑块、「正在播放」高亮方框
         _accent_dark 同时充当强调色的「明亮变体」，用于主色底之上的元素（标签下划线）
         Issue #50 反馈：暗色主题下强调色偏暗、需要调高屏幕亮度才看得清，
         故将各预设的暗色强调色整体上调一档（300→200、200→100），提高亮度与观感饱和度。 -->
    <color name="preset_classic_blue_primary">#1565C0</color>
    <color name="preset_classic_blue_accent">#1565C0</color>
    <color name="preset_classic_blue_primary_dark">#2F3540</color>
    <color name="preset_classic_blue_accent_dark">#90CAF9</color>

    <color name="preset_lake_teal_primary">#00695C</color>
    <color name="preset_lake_teal_accent">#00695C</color>
    <color name="preset_lake_teal_primary_dark">#2A3835</color>
    <color name="preset_lake_teal_accent_dark">#80CBC4</color>

    <color name="preset_forest_green_primary">#2E7D32</color>
    <color name="preset_forest_green_accent">#2E7D32</color>
    <color name="preset_forest_green_primary_dark">#2D392D</color>
    <color name="preset_forest_green_accent_dark">#A5D6A7</color>

    <color name="preset_violet_primary">#6A1B9A</color>
    <color name="preset_violet_accent">#6A1B9A</color>
    <color name="preset_violet_primary_dark">#332B3B</color>
    <color name="preset_violet_accent_dark">#E1BEE7</color>

    <color name="preset_rose_primary">#AD1457</color>
    <color name="preset_rose_accent">#AD1457</color>
    <color name="preset_rose_primary_dark">#382B31</color>
    <color name="preset_rose_accent_dark">#F8BBD0</color>

    <color name="preset_sunset_orange_primary">#BF360C</color>
    <color name="preset_sunset_orange_accent">#BF360C</color>
    <color name="preset_sunset_orange_primary_dark">#392A24</color>
    <color name="preset_sunset_orange_accent_dark">#FFCCBC</color>

    <color name="preset_graphite_primary">#37474F</color>
    <color name="preset_graphite_accent">#37474F</color>
    <color name="preset_graphite_primary_dark">#30353A</color>
    <color name="preset_graphite_accent_dark">#CFD8DC</color>

    <color name="preset_pure_black_primary">#212121</color>
    <color name="preset_pure_black_accent">#212121</color>
    <color name="preset_pure_black_primary_dark">#000000</color>
    <color name="preset_pure_black_accent_dark">#EEEEEE</color>
    <!-- 纯黑预设：暗色主题窗口与内容面均为纯黑系 -->
    <color name="preset_pure_black_window_dark">#000000</color>
    <color name="preset_pure_black_surface_dark">#0E0E0E</color>

    <color name="iconsInItemBackgroundColor">@android:color/black</color>
    <color name="iconsInItemBackgroundColorDark">@android:color/white</color>

    <color name="swipeDeleteIconColor">@color/windowBackground</color>
    <color name="swipeDeleteIconColorDark">@color/windowBackgroundDark</color>
    <color name="swipeDeleteBackgroundColor">#ee0000</color>
    <color name="swipeDeleteBackgroundColorDark">#dd0000</color>

    <!-- 无图标电台动态占位符色板（Material 500 系，白字，双主题通用） -->
    <color name="placeholderColor1">#F44336</color>
    <color name="placeholderColor2">#FF9800</color>
    <color name="placeholderColor3">#FFC107</color>
    <color name="placeholderColor4">#4CAF50</color>
    <color name="placeholderColor5">#2196F3</color>
    <color name="placeholderColor6">#9C27B0</color>
    <color name="placeholderColor7">#607D8B</color>



    <color name="startRecordingColor">#ff3333</color>
</resources>